{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "tuiMode": "regular",
  "defaultProvider": "openai",
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "openwebui/qwen3.8-flash-next",
        "thinking": "medium"
      },
      "delegate": {
        "model": "openwebui/qwen3.8-flash-next",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openwebui/qwen3.8-flash-next",
        "thinking": "xhigh"
      },
      "worker": {
        "model": "azure/gpt-6.1-terra",
        "thinking": "high"
      },
      "reviewer": {
        "model": "openai-codex/gpt-6.2-sol",
        "thinking": "high"
      },
      "evidence-auditor": {
        "model": "azure/gpt-6.1-terra",
        "thinking": "high"
      },
      "oracle": {
        "model": "azure/gpt-6.2-sol",
        "thinking": "high"
      }
    }
  },
  "contextPrune": {
    "enabled": true,
    "showPruneStatusLine": true,
    "summarizerModel": "azure/gpt-6.1-terra",
    "summarizerThinking": "low",
    "pruneOn": "agent-message",
    "batchingMode": "turn",
    "quietOversizedSkips": false,
    "minBatchChars": 2000,
    "recoveryGraceTurns": 3,
    "summarizerIdleTimeoutMs": 45000,
    "summarizerMaxTimeoutMs": 180000,
    "protectedTools": [],
    "protectedPaths": [
      "**/skills/**/*.md",
      "**/gauntlet-overrides.md"
    ],
    "chainCompression": {
      "enabled": true,
      "rollingWindow": 3,
      "idleCleanupMinutes": 180,
      "stripFinalAssistantThinking": true,
      "fuseRangeSummary": true
    },
    "purgeErrors": {
      "enabled": true,
      "cooldownTurns": 2,
      "minArgChars": 500
    },
    "dedupByContentHash": true,
    "autoBudgetThreshold": null,
    "spillThreshold": 65536,
    "spillPreviewBytes": 2048,
    "budgetTurnDelta": null,
    "frontierGapThresholdTokens": null,
    "maxImagesPerRequest": null
  },
  "packages": [
    "npm:pi-subagents",
    "npm:@dietrichgebert/ponytail",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@mtrojnar/pi-usage",
    "npm:@plannotator/pi-extension",
    "npm:@czottmann/pi-automode",
    "npm:pi-context-view",
    "npm:pi-condense",
    "npm:pi-plugin-manager",
    "npm:pi-lens"
  ]
}
