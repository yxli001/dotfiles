{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "yoloMode": false,
  "forwardingTimeoutMs": 600000,
  "authorizerChain": [],
  "permission": {
    "*": "allow",
    "path_read": {
      "*": "allow",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/models.json": "deny",
      "~/.pi/agent/models-store.json": "deny",
      "~/.pi/agent/extensions/pi-permission-system/logs/*permission-review*.jsonl": "deny",
      "~/.pi/agent/sessions/permission-forwarding/*": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.kube/config": "deny",
      "~/.docker/config.json": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.git-credentials": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny"
    },
    "path_write": {
      "*": "allow",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/models.json": "deny",
      "~/.pi/agent/models-store.json": "deny",
      "~/.pi/agent/extensions/pi-permission-system/logs/*permission-review*.jsonl": "deny",
      "~/.pi/agent/sessions/permission-forwarding/*": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.kube/config": "deny",
      "~/.docker/config.json": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.pypirc": "deny",
      "~/.git-credentials": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "external_directory_read": "allow",
    "external_directory_write": {
      "*": "ask",
      "/tmp/*": "allow
    },
    "subagent": "allow",
    "subagents_enable": "allow",
    "ask_user_question": "allow",
    "contact_supervisor": "allow",
    "subagent_supervisor": "allow",
    "bash": {
      "*": "allow",
      "rm": "ask",
      "rm *": "ask",
      "/bin/rm": "ask",
      "/bin/rm *": "ask",
      "/usr/bin/rm": "ask",
      "/usr/bin/rm *": "ask",
      "rmdir": "ask",
      "rmdir *": "ask",
      "unlink": "ask",
      "unlink *": "ask",
      "git *": "allow",
      "git reset": "ask",
      "git reset *": "ask",
      "git clean": "ask",
      "git clean *": "ask",
      "git restore": "ask",
      "git restore *": "ask",
      "git checkout --": "ask",
      "git checkout -- *": "ask",
      "git checkout -f *": "ask",
      "git checkout --force *": "ask",
      "git switch --discard-changes *": "ask",
      "git switch -C *": "ask",
      "git stash drop": "ask",
      "git stash drop *": "ask",
      "git stash clear": "ask",
      "git stash pop": "ask",
      "git stash pop *": "ask",
      "git branch -D *": "ask",
      "git worktree remove *": "ask",
      "git rebase --abort": "ask",
      "git rebase --abort *": "ask",
      "git merge --abort": "ask",
      "git merge --abort *": "ask",
      "git cherry-pick --abort": "ask",
      "git cherry-pick --abort *": "ask",
      "git am --abort": "ask",
      "git am --abort *": "ask",
      "git -C * reset*": "ask",
      "git -C * clean*": "ask",
      "git -C * restore*": "ask",
      "git -C * checkout --*": "ask",
      "git -C * checkout -f*": "ask",
      "git -C * checkout --force*": "ask",
      "git -C * switch --discard-changes*": "ask",
      "git -C * switch -C*": "ask",
      "git -C * stash drop*": "ask",
      "git -C * stash clear*": "ask",
      "git -C * stash pop*": "ask",
      "git -C * branch -D*": "ask",
      "git -C * worktree remove*": "ask",
      "git -C * rebase --abort*": "ask",
      "git -c * reset*": "ask",
      "git -c * clean*": "ask",
      "git -c * restore*": "ask",
      "git -c * checkout --*": "ask",
      "git -c * checkout -f*": "ask",
      "git -c * checkout --force*": "ask",
      "git -c * switch --discard-changes*": "ask",
      "git -c * switch -C*": "ask",
      "git -c * stash drop*": "ask",
      "git -c * stash clear*": "ask",
      "git -c * stash pop*": "ask",
      "git -c * branch -D*": "ask",
      "git -c * worktree remove*": "ask",
      "git -c * rebase --abort*": "ask",
      "git --git-dir=* reset*": "ask",
      "git --git-dir=* clean*": "ask",
      "git --git-dir=* restore*": "ask",
      "git --git-dir=* checkout --*": "ask",
      "git --git-dir=* checkout -f*": "ask",
      "git --git-dir=* checkout --force*": "ask",
      "git --git-dir=* switch --discard-changes*": "ask",
      "git --git-dir=* switch -C*": "ask",
      "git --git-dir=* stash drop*": "ask",
      "git --git-dir=* stash clear*": "ask",
      "git --git-dir=* stash pop*": "ask",
      "git --git-dir=* branch -D*": "ask",
      "git --git-dir=* worktree remove*": "ask",
      "git --git-dir=* rebase --abort*": "ask",
      "git commit": "deny",
      "git commit *": "deny",
      "git push": "deny",
      "git push *": "deny",
      "git * commit": "deny",
      "git * commit *": "deny",
      "git * push": "deny",
      "git * push *": "deny",
      "bash": "ask",
      "bash *": "ask",
      "sh": "ask",
      "sh *": "ask",
      "zsh": "ask",
      "zsh *": "ask",
      "fish": "ask",
      "fish *": "ask",
      "dash": "ask",
      "dash *": "ask",
      "sudo *": "ask",
      "doas *": "ask",
      "su *": "ask",
      "pkexec *": "ask",
      "env *": "ask",
      "eval *": "ask",
      "xargs *": "ask",
      "command *": "ask",
      "exec *": "ask",
      "source *": "ask",
      ". *": "ask",
      "dd *": "ask",
      "mkfs *": "ask",
      "mount *": "ask",
      "umount *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "kill *": "ask",
      "pkill *": "ask",
      "killall *": "ask",
      "reboot *": "ask",
      "shutdown *": "ask"
    }
  }
}
